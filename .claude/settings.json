  "autoCompactEnabled": true,
  "autoMemoryEnabled": true,
  "autoUpdatesChannel": "stable",
  "cleanupPeriodDays": 30,
  "enabledMcpjsonServers": [
    "codebase-memory-mcp",
    "context7",
    "fetch",
    "github"
  ],
  "env": {
    "API_TIMEOUT_MS": "1200000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
