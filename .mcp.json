{
  "mcpServers": {
    "aws-mcp": {
      "type": "http",
      "url": "https://aws-mcp.us-east-1.api.aws/mcp?oauth=initialize"
    },
    "aws-knowledge-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy==0.15.0",
        "--transport",
        "streamablehttp",
        "https://knowledge-mcp.global.api.aws"
      ]
    },
    "aws-documentation-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server==1.2.6"
      ]
    },
    "aws-pricing-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-pricing-mcp-server==1.1.2"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.7.3"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch==2026.11.18"
      ]
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-compressor==0.34.0",
        "--exclude-tools=delete_project",
        "--",
        "codebase-memory-mcp"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "TOKEN=\"${GH_TOKEN:-$GITHUB_TOKEN}\"; exec uvx mcp-compressor==0.34.0 -- https://api.githubcopilot.com/mcp/ -H \"Authorization=Bearer ${TOKEN}\" -H \"X-MCP-Readonly=true\" --auth explicit-headers"
      ]
    },
    "hashicorp-terraform-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "terraform-mcp-server@0.13.0"
      ]
    },
    "awslabs-terraform-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "args": [
        "awslabs.terraform-mcp-server==1.0.18"
      ]
    }
  }
}
