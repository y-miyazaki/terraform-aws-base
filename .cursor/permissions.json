{
  "mcpAllowlist": ["*:*"],
  "terminalAllowlist": [
    "awk",
    "basename",
    "bash",
    "bats",
    "cat",
    "cd",
    "cmp",
    "command",
    "cut",
    "date",
    "df",
    "diff",
    "dirname",
    "du",
    "echo",
    "env",
    "file",
    "find",
    "gh issue list",
    "gh pr list",
    "gh run view",
    "gh workflow list",
    "git add",
    "git blame",
    "git branch",
    "git diff",
    "git grep",
    "git log",
    "git remote -v",
    "git remote show",
    "git rev-parse",
    "git show",
    "git stash list",
    "git stash show",
    "git status",
    "go doc",
    "go env",
    "go list",
    "go test",
    "go version",
    "grep",
    "head",
    "hostname",
    "id",
    "jq",
    "lean-ctx",
    "npx:lean-ctx*",
    "less",
    "ls",
    "more",
    "npm list",
    "npm run",
    "npm test",
    "npm view",
    "printenv",
    "printf",
    "pwd",
    "readlink",
    "realpath",
    "rg",
    "sort",
    "stat",
    "strings",
    "tail",
    "test",
    "tr",
    "tree",
    "uname",
    "uniq",
    "wc",
    "which",
    "whoami",
    "xargs"
  ],
  "autoRun": {
    "allow_instructions": [
      "Prioritize lean-ctx and fetch MCP. Avoid heavy terminal outputs."
    ],
    "block_instructions": [
      "git commit, push, checkout, rebase, reset --hard, clean -f, and branch -D require approval.",
      "Do not read or write .env files, credentials, secrets/, private keys, or cloud credential paths.",
      "Do not write outside the repository (e.g. ~/)."
    ]
  }
}
